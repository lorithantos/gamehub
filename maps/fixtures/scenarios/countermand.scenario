# Six agents ordered across the hall, then countermanded mid-flight.
# Catches an order overriding plans in execution: reservations released and
# reacquired cleanly, no unit finishing the journey nobody wants any more.
version 1
map hall.map
size 12 12
tick 0.016666667
agent 0 1 1
agent 1 1 2
agent 2 1 3
agent 3 2 1
agent 4 2 2
agent 5 2 3
order 0 0,1,2,3,4,5 10 10
order 8 0,1,2,3,4,5 1 10
end 140
