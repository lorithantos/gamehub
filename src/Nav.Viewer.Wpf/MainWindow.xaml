<Window x:Class="Nav.Viewer.Wpf.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nav.Viewer"
        Background="Black"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            The Direct3D surface. NearestNeighbor on the WPF side as well as in
            the sampler: WPF composites this image itself, and its own scaling
            would undo the point sampling if it were left to interpolate.
        -->
        <Image x:Name="Surface"
               Grid.Row="0"
               Grid.Column="0"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True" />

        <!--
            The status line is WPF chrome, not something the renderer draws.
            That decision is why IRenderer has no DrawText, and why raw Direct3D
            11, which cannot draw a glyph at all, needed no font machinery here.
        -->
        <Border x:Name="StatusBar" Grid.Row="1" Grid.Column="0" Background="Black" Padding="6,5">
            <TextBlock x:Name="Status"
                       Foreground="#F5F5F5"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Text="starting..." />
        </Border>

        <!--
            The inspector, the same chrome argument as the status line one size
            up. Its width is FIXED rather than sized to its content: the window
            auto-sizes to this grid, so a panel that grew with the longest value
            in it would move the window every time a unit replanned - the same
            shake the status line's padded counters exist to prevent.

            Its height is driven from the surface in WpfHost.SizeChrome, so the
            map alone decides how tall the window is. The scroll viewer is what
            makes that safe on a small map: it takes the overflow instead of the
            window taking it.
        -->
        <Border x:Name="InspectorPanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="260"
                Background="Black"
                Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <TextBlock x:Name="Inspector"
                           Foreground="#F5F5F5"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           Text="" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
