<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Nav.Viewer.Wpf</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- The renderer writes vertices straight into mapped GPU memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No App.xaml: Main is written by hand, because it needs [STAThread] and
         it needs to parse arguments before deciding whether to open a window. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!--
    The composition root, and the only place in the viewer that holds both
    halves of the seam. Nav.Worlds is where a live world is built and
    Nav.Viewer.Tactics is where one is read into rows; Nav.Viewer.Shared can see
    neither, and the app it hands them to receives rows and a clock rather than
    a kit or a squad. Wiring is the host's job, so these belong here and nowhere
    upstream.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nav.Viewer.Shared\Nav.Viewer.Shared.csproj" />
    <ProjectReference Include="..\Nav.Viewer.Tactics\Nav.Viewer.Tactics.csproj" />
    <ProjectReference Include="..\Nav.Worlds\Nav.Worlds.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <!-- Embedded rather than copied to the output: a resource compiled into the
       assembly cannot go missing at run time, cannot be edited into a startup
       failure, and needs no output-directory hygiene. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\Viewer.hlsl" />
  </ItemGroup>

  <!-- Nav.Core.Models is here for DebugRow: the inspector panel lays out the
       movement layer's own debug rows rather than a viewer row type of the same
       shape. -->
  <ItemGroup>
    <Using Include="Nav.Core.Models" />
    <Using Include="Nav.Viewer.Interfaces" />
    <Using Include="Nav.Viewer.Models" />
  </ItemGroup>

</Project>
