<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    A world here is a board standing ready to be played: the map, the sides,
    their kits and their doctrine, composed and left alone. World and demo were
    one file, and that made the world reachable only by referencing tools\, so
    a host would have depended on a tool to get at a map: the arrow the wrong
    way up. The world lives here, where a demo writing a trace and a viewer
    running it live are both consumers and neither is the other's dependency.

    A world here owns its own tick. The order inside one (doctrine, then the
    board, then the settle, then the fallen taken off) is a design decision that
    belongs with the map and the doctrines rather than with whoever is counting,
    so a caller brings a clock and not a loop. Two loops would be two
    simulations: the live run and the recorded trace would agree right up until
    somebody changed one of them, and after that a finding read off a trace
    would no longer be a finding about the fight anybody is watching. Nothing
    here writes output.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nav.Tactics\Nav.Tactics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Nav.Core" />
    <Using Include="Nav.Core.Interfaces" />
    <Using Include="Nav.Core.Models" />
    <Using Include="Nav.Tactics" />
    <Using Include="Nav.Tactics.Models" />
  </ItemGroup>

</Project>
