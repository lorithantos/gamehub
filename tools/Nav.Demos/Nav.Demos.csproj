<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nav.Demos</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The worlds the demos play come from Nav.Scenarios, so that a viewer can run
    the same guard scenario without referencing a tools project to get at it.
    What is left here is the playing: the tick loop, the trace and the replay.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nav.Scenarios\Nav.Scenarios.csproj" />
    <ProjectReference Include="..\..\src\Nav.Tactics\Nav.Tactics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Nav.Core" />
    <Using Include="Nav.Core.Models" />
    <Using Include="Nav.Scenarios" />
    <Using Include="Nav.Tactics" />
    <Using Include="Nav.Tactics.Interfaces" />
    <Using Include="Nav.Tactics.Models" />
  </ItemGroup>

</Project>
